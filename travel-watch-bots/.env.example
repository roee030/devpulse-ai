# Copy this file to .env and fill in values. Never commit the real .env.

# SerpApi key (google_flights + google_hotels engines) — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Telegram bot token — create a bot via @BotFather on Telegram, it gives you this token
TELEGRAM_BOT_TOKEN=

# Telegram chat id to send alerts to — see README "How to get TELEGRAM_CHAT_ID"
TELEGRAM_CHAT_ID=

# Anthropic API key — only needed if USE_LLM_SUMMARY=true
ANTHROPIC_API_KEY=

# When true, an optional claude-haiku-4-5 call rewrites the message as one caveman-style
# Hebrew line. Off by default — search + filtering never use LLM tokens either way.
USE_LLM_SUMMARY=false

# Timezone used by node-cron schedules
TZ=Asia/Jerusalem

# 'once' (default): run all watches a single time and exit — use this for GitHub Actions cron.
# 'cron': also start an internal node-cron schedule and keep the process alive — use this for
#         an always-on host like Railway.
RUN_MODE=once

# Optional cron overrides (5-field cron, evaluated in TZ above). Only used when RUN_MODE=cron.
FLIGHTS_CRON=0 7 * * *
HOTELS_CRON=0 8 * * *

# Hard caps on SerpApi calls per run, to stay within the free-tier quota.
FLIGHTS_MAX_SERPAPI_CALLS=8
HOTELS_MAX_SERPAPI_CALLS=6
